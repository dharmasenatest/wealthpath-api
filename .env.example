# WealthPath Assessment API — Environment Configuration
# Copy this file to .env and adjust values as needed.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Artificial API Latency ────────────────────────────────────────────────────
# Base delay in milliseconds added to every request (simulates real network).
DELAY_MS=400

# Random jitter added on top of DELAY_MS (0 = no jitter).
DELAY_JITTER=200

# ── Random Failure Simulation ─────────────────────────────────────────────────
# Probability (0.0 to 1.0) that any API call returns a 5xx error.
# 0   = never fail (default, safe for normal use)
# 0.1 = 10% failure rate (useful for testing retry logic)
# 0.3 = 30% failure rate (stress test error handling)
FAILURE_RATE=0

# ── Offline Simulation ────────────────────────────────────────────────────────
# When set to 'true', ALL /spending and /budgets routes return 503.
# Use this to test the offline-first cache behaviour without killing the server.
OFFLINE_MODE=false
